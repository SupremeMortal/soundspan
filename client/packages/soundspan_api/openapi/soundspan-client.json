{
  "components": {
    "schemas": {
      "ApiDocumentInfo": {
        "additionalProperties": false,
        "properties": {
          "info": {
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string"
              }
            },
            "required": [
              "version"
            ],
            "type": "object"
          }
        },
        "required": [
          "info"
        ],
        "type": "object"
      },
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AuthConfig": {
        "additionalProperties": false,
        "properties": {
          "localLoginEnabled": {
            "type": "boolean"
          },
          "oidcEnabled": {
            "type": "boolean"
          },
          "oidcProviderName": {
            "type": "string"
          }
        },
        "required": [
          "localLoginEnabled",
          "oidcEnabled",
          "oidcProviderName"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "properties": {
          "draining": {
            "type": "boolean"
          },
          "role": {
            "enum": [
              "all",
              "api",
              "worker"
            ],
            "type": "string"
          },
          "startupComplete": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "uptimeSeconds": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "draining",
          "role",
          "startupComplete",
          "status",
          "uptimeSeconds",
          "version"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "token": {
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "password",
          "username"
        ],
        "type": "object"
      },
      "LoginTokenResponse": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/LoginUser"
          }
        },
        "required": [
          "refreshToken",
          "token",
          "user"
        ],
        "type": "object"
      },
      "LoginTwoFactorChallenge": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "requires2FA": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "message",
          "requires2FA"
        ],
        "type": "object"
      },
      "LoginUser": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "admin"
            ],
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "id",
          "role",
          "username"
        ],
        "type": "object"
      },
      "MessageResponse": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "OnboardingStatus": {
        "additionalProperties": false,
        "properties": {
          "hasAccount": {
            "type": "boolean"
          },
          "needsOnboarding": {
            "type": "boolean"
          }
        },
        "required": [
          "hasAccount",
          "needsOnboarding"
        ],
        "type": "object"
      },
      "RefreshSessionRequest": {
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "SessionTokens": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken",
          "token"
        ],
        "type": "object"
      },
      "SystemFeatures": {
        "additionalProperties": false,
        "properties": {
          "audioAnalysis": {
            "type": "boolean"
          },
          "autoPlaylists": {
            "type": "boolean"
          },
          "discovery": {
            "type": "boolean"
          },
          "federation": {
            "type": "boolean"
          },
          "loudnessTargetLufs": {
            "type": "number"
          },
          "vibeEmbeddings": {
            "type": "boolean"
          }
        },
        "required": [
          "audioAnalysis",
          "autoPlaylists",
          "discovery",
          "federation",
          "loudnessTargetLufs",
          "vibeEmbeddings"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "soundspan client surface",
    "version": "2.6.1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/config": {
      "get": {
        "operationId": "getAuthConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [],
        "summary": "Sign-in methods the server offers",
        "tags": [
          "session"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Answers a token response, or a second-factor challenge when the account has 2FA and `token` is absent. 403 when local login is disabled.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginTokenResponse"
                    },
                    {
                      "$ref": "#/components/schemas/LoginTwoFactorChallenge"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [],
        "summary": "Sign in with a username or email and password",
        "tags": [
          "session"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [],
        "summary": "Sign out; tokens are discarded by the client",
        "tags": [
          "session"
        ]
      }
    },
