          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [],
        "summary": "Exchange a refresh token for new access and refresh tokens",
        "tags": [
          "session"
        ]
      }
    },
