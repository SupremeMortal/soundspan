          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"base_url\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"username\" TEXT NOT NULL, \"user_display_name\" TEXT NULL, \"role\" TEXT NOT NULL, \"auth_kind\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"credential_created_at\" TEXT NOT NULL, \"credential_expires_at\" TEXT NULL, \"server_version\" TEXT NULL, \"features\" TEXT NULL, \"features_fetched_at\" TEXT NULL, \"state\" TEXT NOT NULL, \"last_used_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"base_url\", \"user_id\"));"
        }
      ]
