      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"key\" TEXT NOT NULL, \"playback_id\" TEXT NULL, \"json\" TEXT NOT NULL, \"album_id\" TEXT NULL, \"artist_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "albums",
