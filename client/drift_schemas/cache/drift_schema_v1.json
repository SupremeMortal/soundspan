        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"albums\" (\"id\" TEXT NOT NULL, \"json\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"artist_name\" TEXT NOT NULL, \"year\" INTEGER NULL, \"fetched_at\" TEXT NOT NULL, \"detail_fetched_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"artists\" (\"id\" TEXT NOT NULL, \"json\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"fetched_at\" TEXT NOT NULL, \"detail_fetched_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" TEXT NOT NULL, \"json\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"fetched_at\" TEXT NOT NULL, \"detail_fetched_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
