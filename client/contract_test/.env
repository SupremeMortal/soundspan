# Throwaway values for the variables the root docker-compose.yml marks
# required, and JWT_SECRET, which that file passes as an empty string that the
# backend rejects. Used only by the contract server of compose.yaml, which is
# published on 127.0.0.1 and removed with `docker compose down -v`.
POSTGRES_PASSWORD=contract-postgres-password
SESSION_SECRET=contract-session-secret-0123456789abcdef
SETTINGS_ENCRYPTION_KEY=contract-settings-key-0123456789abcdef
INTERNAL_API_SECRET=contract-internal-secret-0123456789abcdef
JWT_SECRET=contract-jwt-secret-0123456789abcdef0123
